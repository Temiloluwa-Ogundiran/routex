# Database
DB_URL=postgresql+asyncpg://user:password@host:port/dbname

# Redis (broker + backend for Celery)
REDIS_URL=redis://default:password@host:port

# Application secrets
AGG_SECRET=                  # Fernet key used to encrypt/decrypt merchant token secrets
AUTH_SECRET=                 # JWT signing secret
SERVER_URL=                  # e.g. https://api.yourdomain.com

# SendGrid email
SENDGRID_API_KEY=
AUTH_EMAIL=                  # From-address for OTP / password-reset emails
RECEIPT_EMAIL=               # From-address for transaction receipt emails

# Payment processors
KORA_SECRET_KEY=
KORA_LIVE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_LIVE_SECRET_KEY=
FLTW_SECRET_KEY=
FLTW_SECRET_HASH=
BASQET_SECRET=
BASQET_LIVE_SECRET=

# Twilio (SMS)
TWILLO_AUTH_TOKEN=

# Proxy (optional)
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
